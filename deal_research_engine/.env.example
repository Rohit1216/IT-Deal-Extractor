# Copy this file to ".env" and fill in real values there.
# ".env" is git-ignored and must never be committed.

# --- Mode --------------------------------------------------------------
# true  -> no external API calls, uses canned sample data (free, offline)
# false -> makes real Serper + (later) Claude API calls
MOCK_MODE=true

# --- API keys ------------------------------------------------------------
# Only required when MOCK_MODE=false.
CLAUDE_API_KEY=
SEARCH_API_KEY=
SEARCH_PROVIDER=serper

# --- Research loop controls ----------------------------------------------
MAX_SEARCH_ITERATIONS=5
MAX_SOURCES=50
MIN_RELEVANCE_SCORE=0.50
RESULTS_PER_QUERY=10

# --- Paths -----------------------------------------------------------------
OUTPUT_DIR=outputs
